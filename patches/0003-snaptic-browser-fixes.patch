@@ -0,0 +1,13 @@
+shader_type canvas_item;
+render_mode unshaded;
+
+uniform float amount = 1.0;
+
+void fragment() {
+	vec2 block = floor(UV * vec2(54.0, 40.0));
+	float noise = fract(sin(dot(block, vec2(12.9898, 78.233))) * 43758.5453);
+	vec2 offset = vec2(sin(TIME * 12.0 + noise * 6.28), cos(noise * 6.28));
+	vec2 sample_uv = clamp(UV + offset * (1.0 - amount) * 0.08, vec2(0.0), vec2(1.0));
+	COLOR = texture(TEXTURE, sample_uv);
+	COLOR.a *= amount * step(noise * 0.8, amount);
+}
